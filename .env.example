NEBIUS_API_KEY=your-token-factory-key
TAVILY_API_KEY=your-tavily-key
NEBIUS_BASE_URL=https://api.studio.nebius.com/v1/
NEBIUS_MODEL=meta-llama/Llama-3.3-70B-Instruct
# Optional: a faster/cheaper model for planning and summaries, and a fallback on overload
NEBIUS_MODEL_FAST=
NEBIUS_MODEL_FALLBACK=
# Optional alert delivery (otherwise alerts are written to ./outbox)
QUILL_FAMILY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
QUILL_ORG_WEBHOOK=
